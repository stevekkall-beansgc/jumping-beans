{
  "$id": "taxonomy-classification.schema.json",
  "title": "Jumping Beans versioned product taxonomy classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taxonomyRegistry", "classifications"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "taxonomyRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "adapters"],
      "properties": {
        "canonical": { "$ref": "#/$defs/canonicalTaxonomy" },
        "adapters": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/adapter" }
        }
      }
    },
    "classifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/classification" }
    }
  },
  "$defs": {
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "code", "codeStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] },
        "codeStatus": { "type": "string", "enum": ["verified", "unmapped", "not-provided"] }
      }
    },
    "canonicalTaxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority", "intendedBackbone", "version", "codeStatus", "provenance"],
      "properties": {
        "id": { "const": "gs1-gpc" },
        "authority": { "const": "GS1" },
        "intendedBackbone": { "const": true },
        "version": { "type": ["string", "null"] },
        "codeStatus": { "type": "string", "enum": ["verified", "unmapped", "not-loaded"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceTaxonomy", "sourceVersion", "status", "provenance"],
      "properties": {
        "id": { "type": "string", "enum": ["partner-native", "gs1-gpc", "google-product-taxonomy", "unspsc"] },
        "sourceTaxonomy": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["active-slot", "unmapped"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },
    "effectiveDates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": ["string", "null"], "format": "date" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "source", "relation", "confidence", "method", "provenance", "effective"],
      "properties": {
        "adapterId": { "type": "string", "enum": ["partner-native", "gs1-gpc", "google-product-taxonomy", "unspsc"] },
        "source": { "$ref": "#/$defs/taxonomyReference" },
        "relation": { "type": "string", "enum": ["exact", "broader", "narrower", "related", "unmapped"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string", "enum": ["partner-declared", "manual-review", "automated", "not-mapped"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "effective": { "$ref": "#/$defs/effectiveDates" }
      }
    },
    "canonicalAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "status", "provenance"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean"] },
        "status": { "type": "string", "enum": ["observed", "not-provided"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "componentStatus", "components"],
      "properties": {
        "kind": { "type": "string", "enum": ["single", "bundle"] },
        "componentStatus": { "type": "string", "enum": ["not-applicable", "not-provided", "complete"] },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partnerSku", "quantity"],
            "properties": {
              "partnerSku": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partnerId", "partnerSku", "gtin", "canonical", "mappings", "canonicalAttributes", "bundle", "effective"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "partnerId": { "type": "string", "minLength": 1 },
        "partnerSku": { "type": "string", "minLength": 1 },
        "gtin": { "type": ["string", "null"], "pattern": "^[0-9]{8,14}$" },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "keyStatus", "taxonomy", "taxonomyVersion", "officialCode", "officialCodeStatus"],
          "properties": {
            "key": { "type": "string", "pattern": "^jb:temporary:" },
            "keyStatus": { "const": "temporary" },
            "taxonomy": { "const": "gs1-gpc" },
            "taxonomyVersion": { "type": ["string", "null"] },
            "officialCode": { "type": ["string", "null"] },
            "officialCodeStatus": { "type": "string", "enum": ["verified", "unmapped"] }
          }
        },
        "mappings": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/mapping" } },
        "canonicalAttributes": { "type": "array", "items": { "$ref": "#/$defs/canonicalAttribute" } },
        "bundle": { "$ref": "#/$defs/bundle" },
        "effective": { "$ref": "#/$defs/effectiveDates" }
      }
    }
  }
}
